{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/bundle-template.mjs",
    "build": "next build --webpack && node scripts/check-compile-hints.mjs",
    "bundle-template": "node scripts/bundle-template.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:schema": "tsx scripts/check-schema-drift.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:validate": "tsx scripts/init-db.ts --validate",
    "predev": "node scripts/bundle-template.mjs",
    "dev": "next dev",
    "hash-password": "node scripts/hash-password.ts",
    "lint": "ultracite check . --error-on-warnings",
    "lint:next": "eslint --max-warnings=0",
    "perf:eval": "tsx evals/performance/run.ts",
    "perf:seed": "tsx evals/performance/seed.ts",
    "setup:local": "tsx scripts/init-local.ts",
    "start": "next start",
    "test": "pnpm -C ../.. exec vitest run apps/hub --pool=forks",
    "typecheck": "next typegen && tsc --noEmit"
  },
