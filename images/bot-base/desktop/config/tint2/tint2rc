# Busy: the taskbar of the bot's computer (images/bot-base/desktop-session.sh).
# Background 1: the panel.
rounded = 0
border_width = 0
background_color = #16181d 100
border_color = #000000 0
# Background 2: the focused window's button.
rounded = 6
border_width = 0
background_color = #ffffff 16
border_color = #000000 0

panel_items = LTC
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 8 4 8
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_background_id = 1
strut_policy = follow_size
wm_menu = 0
panel_dock = 0

launcher_padding = 4 4 8
launcher_background_id = 0
launcher_icon_size = 26
launcher_icon_theme = Adwaita
launcher_tooltip = 1
launcher_item_app = /usr/local/share/busy-desktop/applications/busy-chrome.desktop
