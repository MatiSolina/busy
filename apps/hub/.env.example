# Copy this file to .env.local for local development. It contains placeholders
# only; never commit .env.local or paste real credentials into this file.

# A local Postgres database. For deployment, use the connection strings supplied
# by your Vercel Postgres/Supabase/Neon integration instead.
DATABASE_URL=postgresql://busy:busy@127.0.0.1:5432/busy
DATABASE_URL_UNPOOLED=postgresql://busy:busy@127.0.0.1:5432/busy

# A private Vercel Blob store connected to your hub project. Required for
# uploads, library objects and optional desktop release downloads.
BLOB_READ_WRITE_TOKEN=

# The one local account. Generate BUSY_PASSWORD_HASH with:
#   pnpm --filter hub hash-password
BUSY_USER=owner
BUSY_PASSWORD_HASH=replace-with-output-from-hash-password

# Use different random values for every environment. These values protect
# cookies, encrypted OAuth records, cron endpoints and hub-to-bot requests.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-a-random-cron-secret

# Required when the hub creates Vercel bot projects. Leave blank for a UI-only
# local build, but set all three values before creating a bot.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Build and publish your own image first: docs/bot-base-image.md. Required
# before deploying any bot, and copied by the hub into each bot project.
BOT_BASE_IMAGE=

# The public origin of this hub and the wildcard origin used by its bots.
# Local development can use the values below; production must use HTTPS.
HUB_URL=http://localhost:3000
BOTS_DOMAIN=localhost

# Production hub-to-bot signing key. Run scripts/gen-hub-key.ts after linking
# the Vercel project; never copy this private key into source control.
HUB_SIGNING_KEY=

# MCP Apps need a different HTTPS origin in production. The local sandbox uses
# a loopback origin while developing and is optional until an MCP App is used.
MCP_APP_SANDBOX_ORIGIN=http://127.0.0.1:3001

# Optional integrations. Keep empty unless you provision the corresponding
# provider or feature in your own account.
TOKEN_PASS_API_KEY=
# Optional for local SDK/model paths and provider-backed evaluations.
# Managed bot/coding identity still needs its Vercel OIDC configuration.
AI_GATEWAY_API_KEY=
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
BUSY_VERCEL_USERS=
HISTORY_EMBEDDINGS_ENABLED=0
HISTORY_EMBEDDING_MODEL=
HISTORY_EMBEDDING_URL=
HISTORY_EMBEDDING_API_KEY=
NEXT_PUBLIC_RUM=0

# Optional desktop distribution (after publishing your own archive).
BUSY_APP_VERSION=
BUSY_APP_SHA256=

# Development-only bypass. Keep this commented out unless the hub is bound to
# a private local machine; never enable it on a public deployment.
# BUSY_DEV_NO_AUTH=1
